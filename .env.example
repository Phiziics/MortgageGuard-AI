# Project
PROJECT_NAME=MortgageGuard-AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=mortgageguard-credit-risk-development
MLFLOW_REGISTERED_MODEL_NAME=MortgageGuard-Credit-Risk-Model
MLFLOW_MODEL_ALIAS=champion

# Local paths
DATA_CONFIG_PATH=configs/data.yaml
MODEL_CONFIG_PATH=configs/model.yaml
MONITORING_CONFIG_PATH=configs/monitoring.yaml

RAW_DATA_DIRECTORY=data/raw
BRONZE_DATA_DIRECTORY=data/bronze
SILVER_DATA_DIRECTORY=data/silver
GOLD_DATA_DIRECTORY=data/gold

ARTIFACTS_DIRECTORY=artifacts
MODELS_DIRECTORY=models
REPORTS_DIRECTORY=reports

# Deployment
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Streamlit
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Model serving
DEFAULT_MODEL_ALIAS=champion
PREDICTION_LOG_DIRECTORY=artifacts/prediction_logs

# Monitoring
MONITORING_METRICS_DIRECTORY=artifacts/monitoring
MONITORING_REPORT_DIRECTORY=reports/monitoring
MONITORING_INCIDENT_DIRECTORY=reports/incidents

# Optional AWS configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_DATA_PREFIX=mortgageguard
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=